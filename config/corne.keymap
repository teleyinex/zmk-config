/*
 * Corne ZMK keymap — translated from QMK
 * Hardware: nice!nano v2 + standard Corne PCB
 * Dependencies: zmk-locales module (see west.yml)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_es.h>

/* ── Layer indices ─────────────────────────────────────────────────────────── */
#define BASE  0
#define NAV   1
#define NUM   2
#define SYM   3
#define BT    4

/*
 * All keycodes used as hold-tap arguments must be plain integer expressions.
 * The DTS parser does not accept macro expansions that contain operators
 * (|, <<, etc.) as bare arguments to multi-cell bindings — they need to be
 * wrapped so the C preprocessor reduces them before DTS sees them.
 * Wrapping every ES_ keycode and HYPER in () here achieves that.
 */
#define HYPER   (LS(LA(LC(LGUI))))
#define _NTIL   (ES_NTIL)
#define _ACUT   (ES_ACUT)
#define _DIAE   (ES_DIAE)
#define _COMM   (ES_COMM)
#define _DOT    (ES_DOT)
#define _ASTR   (ES_ASTR)
#define _MINS   (ES_MINS)
#define _SLSH   (ES_SLSH)
#define _PLUS   (ES_PLUS)
#define _SQT    (ES_SQT)
#define _N0     (ES_N0)
#define _N1     (ES_N1)
#define _N2     (ES_N2)
#define _N3     (ES_N3)
#define _N4     (ES_N4)
#define _N5     (ES_N5)
#define _N6     (ES_N6)
#define _N7     (ES_N7)
#define _N8     (ES_N8)
#define _N9     (ES_N9)
#define _AMPR   (ES_AMPR)
#define _EXLM   (ES_EXLM)
#define _AT     (ES_AT)
#define _HASH   (ES_HASH)
#define _DLR    (ES_DLR)
#define _PERC   (ES_PERC)
#define _PIPE   (ES_PIPE)
#define _LBRC   (ES_LBRC)
#define _RBRC   (ES_RBRC)
#define _LPAR   (ES_LPAR)
#define _RPAR   (ES_RPAR)
#define _EQUAL  (ES_EQUAL)
#define _DQT    (ES_DQT)
#define _BSLH   (ES_BSLH)
#define _LBKT   (ES_LBKT)
#define _RBKT   (ES_RBKT)
#define _LT     (ES_LT)
#define _GT     (ES_GT)
#define _QMARK  (ES_QMARK)
#define _IEXL   (ES_IEXL)
#define _IQUE   (ES_IQUE)
#define _GRV    (ES_GRV)

/ {

    macros {
        back_word: back_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp LEFT>
                , <&macro_release &kp LALT>
                ;
        };

        fwd_word: fwd_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp RIGHT>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        /* Shift HRM (A, Ñ): 170 ms, time-only */
        hm_s: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <170>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        /* Other HRM: 180 ms */
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        /* LT for NAV / space */
        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            bindings = <&mo>, <&kp>;
        };

        /* LT for SYM / enter */
        lt_sym: lt_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 41>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ── 0: BASE ───────────────────────────────────────────────────── */
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC        &kp Q          &kp W        &kp E        &kp R        &kp T
                &kp Y          &kp U          &kp I        &kp O        &kp P        &kp BSPC

                &kp HYPER      &hm_s LSFT A   &hm LALT S   &hm LCTL D   &hm LGUI F   &kp G
                &kp H          &hm RGUI J     &hm RCTL K   &hm RALT L   &hm_s RSFT _NTIL   &kp _ACUT

                &none          &kp Z          &kp X        &kp C        &kp V        &kp B
                &kp N          &kp M          &kp _COMM    &kp _DOT     &kp SLASH    &kp RSFT

                &tog BT        &mo NUM        &lt_nav NAV SPC
                &kp SPC        &lt_sym SYM RET   &kp HYPER
            >;
        };

        /* ── 1: NAV ────────────────────────────────────────────────────── */
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp TAB    &none       &fwd_word   &none       &none      &none
                &kp F1     &kp F2      &kp F3      &kp F4      &kp F5     &kp BSPC

                &none      &none       &none       &none       &none      &none
                &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &none      &kp _DIAE

                &none      &none       &kp DEL     &none       &none      &back_word
                &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &none      &none

                &trans     &trans      &trans
                &trans     &trans      &trans
            >;
        };

        /* ── 2: NUM ────────────────────────────────────────────────────── */
        num_layer {
            display-name = "NUM";
            bindings = <
                &none      &none    &none    &none    &none    &none
                &kp _ASTR  &kp _N7  &kp _N8  &kp _N9  &kp _MINS  &kp BSPC

                &none      &none    &none    &none    &none    &none
                &kp _SLSH  &kp _N4  &kp _N5  &kp _N6  &kp _PLUS  &kp _SQT

                &none      &none    &none    &none    &none    &none
                &kp _N0    &kp _N1  &kp _N2  &kp _N3  &kp _DOT   &kp RSFT

                &trans     &trans   &trans
                &kp SPC    &trans   &trans
            >;
        };

        /* ── 3: SYM ────────────────────────────────────────────────────── */
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp _AMPR   &kp _EXLM  &kp _AT    &kp _HASH  &kp _DLR   &kp _PERC
                &none       &kp _IEXL  &none      &none      &none      &kp BSPC

                &kp _PIPE   &kp _LBRC  &kp _RBRC  &kp _LPAR  &kp _RPAR  &kp _EQUAL
                &kp C_PP    &kp _DQT   &kp C_VOL_DN  &kp C_VOL_UP  &none  &none

                &kp _BSLH   &kp _LBKT  &kp _RBKT  &kp _LT    &kp _GT    &kp _QMARK
                &none       &kp _IQUE  &none      &none      &none      &none

                &trans      &trans     &trans
                &kp SPC     &trans     &trans
            >;
        };

        /* ── 4: BT ─────────────────────────────────────────────────────── */
        bt_layer {
            display-name = "BT";
            bindings = <
                &to BASE  &none  &none  &none  &none  &none
                &none     &none  &none  &none  &none  &none

                &none          &none          &none          &none          &none  &none
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none

                &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &bt BT_CLR  &none

                &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };
    };
};
