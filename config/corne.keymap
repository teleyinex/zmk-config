/*
 * Corne ZMK keymap — translated from QMK
 * Hardware: nice!nano v2 + standard Corne PCB
 * Dependencies: zmk-locales module (see west.yml)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_es.h>

/* ── Layer indices ─────────────────────────────────────────────────────────── */
#define BASE  0
#define NAV   1
#define NUM   2
#define SYM   3
#define BT    4

/*
 * Hyper = LGUI + LCTL + LALT + LSFT.
 * Must be wrapped in () everywhere it appears inside a <bindings> list
 * so the DTS parser sees it as a single parenthesized expression.
 */
#define HYPER (LS(LA(LC(LGUI))))

/ {

    macros {
        back_word: back_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp LEFT>
                , <&macro_release &kp LALT>
                ;
        };

        fwd_word: fwd_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp RIGHT>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        /* Shift HRM (A, Ñ): 170 ms, time-only */
        hm_s: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <170>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        /* Other HRM: 180 ms */
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        /* LT for NAV / space */
        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            bindings = <&mo>, <&kp>;
        };

        /* LT for SYM / enter — hold-preferred, no quick-tap repeat */
        lt_sym: lt_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Both outer thumb keys → Caps Word */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 41>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ── 0: BASE ───────────────────────────────────────────────────── */
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC          &kp Q         &kp W         &kp E         &kp R         &kp T
                &kp Y            &kp U         &kp I         &kp O         &kp P         &kp BSPC

                &kp HYPER        &hm_s LSFT A  &hm LALT S    &hm LCTL D    &hm LGUI F    &kp G
                &kp H            &hm RGUI J    &hm RCTL K    &hm RALT L    &hm_s RSFT (ES_NTIL)  &kp (ES_ACUT)

                &none            &kp Z         &kp X         &kp C         &kp V         &kp B
                &kp N            &kp M         &kp (ES_COMM) &kp (ES_DOT)  &kp SLASH     &kp RSFT

                &tog BT          &mo NUM       &lt_nav NAV SPC
                &kp SPC          &lt_sym SYM RET  &kp HYPER
            >;
        };

        /* ── 1: NAV ────────────────────────────────────────────────────── */
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp TAB   &none      &fwd_word  &none   &none   &none
                &kp F1    &kp F2     &kp F3     &kp F4  &kp F5  &kp BSPC

                &none     &none      &none      &none   &none   &none
                &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &kp (ES_DIAE)

                &none     &none      &kp DEL    &none   &none   &back_word
                &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &none  &none

                &trans    &trans     &trans
                &trans    &trans     &trans
            >;
        };

        /* ── 2: NUM ────────────────────────────────────────────────────── */
        num_layer {
            display-name = "NUM";
            bindings = <
                &none  &none  &none  &none  &none  &none
                &kp (ES_ASTR)  &kp (ES_N7)  &kp (ES_N8)  &kp (ES_N9)  &kp (ES_MINS)  &kp BSPC

                &none  &none  &none  &none  &none  &none
                &kp (ES_SLSH)  &kp (ES_N4)  &kp (ES_N5)  &kp (ES_N6)  &kp (ES_PLUS)  &kp (ES_SQT)

                &none  &none  &none  &none  &none  &none
                &kp (ES_N0)  &kp (ES_N1)  &kp (ES_N2)  &kp (ES_N3)  &kp (ES_DOT)  &kp RSFT

                &trans  &trans  &trans
                &kp SPC  &trans  &trans
            >;
        };

        /* ── 3: SYM ────────────────────────────────────────────────────── */
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp (ES_AMPR)  &kp (ES_EXLM)  &kp (ES_AT)   &kp (ES_HASH)  &kp (ES_DLR)   &kp (ES_PERC)
                &none          &kp (ES_IEXL)  &none          &none          &none          &kp BSPC

                &kp (ES_PIPE)  &kp (ES_LBRC)  &kp (ES_RBRC) &kp (ES_LPAR)  &kp (ES_RPAR)  &kp (ES_EQUAL)
                &kp C_PP       &kp (ES_DQT)   &kp C_VOL_DN   &kp C_VOL_UP   &none          &none

                &kp (ES_BSLH)  &kp (ES_LBKT)  &kp (ES_RBKT) &kp (ES_LT)    &kp (ES_GT)    &kp (ES_QMARK)
                &none          &kp (ES_IQUE)  &none          &none          &none          &none

                &trans  &trans  &trans
                &kp SPC  &trans  &trans
            >;
        };

        /* ── 4: BT ─────────────────────────────────────────────────────── */
        bt_layer {
            display-name = "BT";
            bindings = <
                &to BASE  &none  &none  &none  &none  &none
                &none     &none  &none  &none  &none  &none

                &none  &none  &none  &none  &none  &none
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none

                &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &bt BT_CLR  &none

                &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };
    };
};
