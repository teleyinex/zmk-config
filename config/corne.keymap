/*
 * Corne ZMK keymap — translated from QMK
 * Hardware: nice!nano v2 + standard Corne PCB
 * Dependencies: zmk-locales module (see west.yml)
 *
 * NOTE on ES_ keycodes in hold-tap bindings:
 * The Zephyr DTS parser runs before the C preprocessor, so ES_ macros
 * (which expand to ZMK_HID_USAGE(...) expressions) cannot be used as
 * arguments to multi-cell behaviors like hold-tap.
 * Solution: use the underlying ZMK base keycode directly.
 *
 * Spanish layout → US HID keycode mapping for affected keys:
 *   Ñ  (ES_NTIL) = SEMI       (;  on US)
 *   ´  (ES_ACUT) = SQT        ('  on US)  — dead acute
 *   ¨  (ES_DIAE) = LS(SQT)    ("  on US)  — dead diaeresis
 *   ,  (ES_COMM) = COMMA       (identical)
 *   .  (ES_DOT)  = DOT         (identical)
 *   -  (ES_MINS) = FSLH        (/  on US)
 *   *  (ES_ASTR) = LS(RBKT)    (}  on US) -- via shift
 *   /  (ES_SLSH) = LS(N7)
 *   +  (ES_PLUS) = RBKT
 *   '  (ES_SQT)  = MINUS
 *   =  (ES_EQUAL)= LS(N0)
 *   &  (ES_AMPR) = LS(N6)
 *   !  (ES_EXLM) = LS(N1)
 *   @  (ES_AT)   = RA(N2)
 *   #  (ES_HASH) = LS(N3)  -- (on ES layout # is RA(N3) actually, but
 *                              keymap_spanish.h maps HASH=LS(N3) for £/·)
 *                              Use RA(N3) for # on Spanish ISO
 *   $  (ES_DLR)  = LS(N4)
 *   %  (ES_PERC) = LS(N5)
 *   |  (ES_PIPE) = RA(N1)  -- (on ES: AltGr+1)
 *   {  (ES_LBRC) = RA(SQT)
 *   }  (ES_RBRC) = RA(BSLH)
 *   (  (ES_LPAR) = LS(N8)
 *   )  (ES_RPAR) = LS(N9)
 *   [  (ES_LBKT) = RA(LBKT)
 *   ]  (ES_RBKT) = RA(RBKT)
 *   <  (ES_LT)   = NON_US_BSLH
 *   >  (ES_GT)   = LS(NON_US_BSLH)
 *   ?  (ES_QMARK)= LS(MINUS)
 *   ¡  (ES_IEXL) = EQUAL
 *   ¿  (ES_IQUE) = LS(EQUAL)
 *   \  (ES_BSLH) = RA(MINUS)
 *   `  (ES_GRV)  = LBKT        — dead grave
 *   0-9: N0-N9 (identical)
 *
 * For &kp bindings the ES_ macros work fine — only hold-tap arguments
 * need the raw codes. This keymap uses raw codes everywhere for consistency.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* ── Layer indices ─────────────────────────────────────────────────────────── */
#define BASE  0
#define NAV   1
#define NUM   2
#define SYM   3
#define BT    4

/* ── Hyper ─────────────────────────────────────────────────────────────────── */
#define HYPER LS(LA(LC(LGUI)))

/* ── Spanish layout raw keycodes ───────────────────────────────────────────── */
/* Simple (unshifted) */
#define ES_N    SEMI          /* Ñ */
#define ES_ACU  SQT           /* ´ dead */
#define ES_DIA  LS(SQT)       /* ¨ dead */
#define ES_MNS  FSLH          /* - */
#define ES_PLU  RBKT          /* + */
#define ES_APO  MINUS         /* ' */
#define ES_GRV  LBKT          /* ` dead */
#define ES_IEX  EQUAL         /* ¡ */
#define ES_IQU  LS(EQUAL)     /* ¿ */
#define ES_LT   NON_US_BSLH   /* < */
#define ES_GT   LS(NON_US_BSLH) /* > */
#define ES_BSL  RA(MINUS)     /* \ */
#define ES_LBR  RA(SQT)       /* { */
#define ES_RBR  RA(BSLH)      /* } */
#define ES_LBK  RA(LBKT)      /* [ */
#define ES_RBK  RA(RBKT)      /* ] */
#define ES_PIP  RA(N1)        /* | */
#define ES_AT   RA(N2)        /* @ */
#define ES_HSH  RA(N3)        /* # */
/* Shifted */
#define ES_EXL  LS(N1)        /* ! */
#define ES_QOT  LS(N2)        /* " */
#define ES_DLR  LS(N4)        /* $ */
#define ES_PER  LS(N5)        /* % */
#define ES_AMP  LS(N6)        /* & */
#define ES_SLS  LS(N7)        /* / */
#define ES_LPR  LS(N8)        /* ( */
#define ES_RPR  LS(N9)        /* ) */
#define ES_EQL  LS(N0)        /* = */
#define ES_AST  LS(RBKT)      /* * */
#define ES_QMK  LS(FSLH)      /* ? */

/ {

    macros {
        back_word: back_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp LEFT>
                , <&macro_release &kp LALT>
                ;
        };

        fwd_word: fwd_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp RIGHT>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        /*
         * Shift HRM (A, Ñ): tap-unless-interrupted, 200ms.
         * Hold activates only on timeout OR if another key is pressed but
         * NOT released before tapping-term — so fast shift+letter works as
         * long as you release the letter before the term expires.
         * require-prior-idle-ms prevents false shift during fast typing rolls.
         */
        hm_s: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Other HRM (Alt, Ctrl, GUI): longer tapping-term to avoid
         * accidental triggers. require-prior-idle-ms is the key setting
         * for comfortable homerow mods during fast typing.
         */
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        /* LT for NAV / space */
        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /* LT for SYM / enter */
        lt_sym: lt_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 41>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ── 0: BASE ───────────────────────────────────────────────────── */
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC          &kp Q         &kp W        &kp E        &kp R        &kp T
                &kp Y            &kp U         &kp I        &kp O        &kp P        &kp BSPC

                &kp HYPER        &hm_s LSFT A  &hm LALT S   &hm LCTL D   &hm LGUI F   &kp G
                &kp H            &hm RGUI J    &hm RCTL K   &hm RALT L   &hm_s RSFT ES_N   &kp ES_ACU

                &none            &kp Z         &kp X        &kp C        &kp V        &kp B
                &kp N            &kp M         &kp COMMA    &kp DOT      &kp FSLH     &kp RSFT

                &mo BT           &mo NUM       &lt_nav NAV SPC
                &kp SPC          &lt_sym SYM RET   &kp HYPER
            >;
        };

        /* ── 1: NAV ────────────────────────────────────────────────────── */
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp TAB    &none       &fwd_word   &none       &none      &none
                &kp F1     &kp F2      &kp F3      &kp F4      &kp F5     &kp BSPC

                &none      &none       &none       &none       &none      &none
                &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &none      &kp ES_DIA

                &none      &none       &kp DEL     &none       &none      &back_word
                &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &none      &none

                &trans     &trans      &trans
                &trans     &trans      &trans
            >;
        };

        /* ── 2: NUM ────────────────────────────────────────────────────── */
        num_layer {
            display-name = "NUM";
            bindings = <
                &none       &none    &none    &none    &none    &none
                &kp ES_AST  &kp N7   &kp N8   &kp N9   &kp ES_MNS  &kp BSPC

                &none       &none    &none    &none    &none    &none
                &kp ES_SLS  &kp N4   &kp N5   &kp N6   &kp ES_PLU  &kp ES_APO

                &none       &none    &none    &none    &none    &none
                &kp N0      &kp N1   &kp N2   &kp N3   &kp DOT     &kp RSFT

                &trans      &trans   &trans
                &kp SPC     &trans   &trans
            >;
        };

        /* ── 3: SYM ────────────────────────────────────────────────────── */
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp ES_AMP  &kp ES_EXL  &kp ES_AT   &kp ES_HSH  &kp ES_DLR  &kp ES_PER
                &none       &kp ES_IEX  &none       &none       &none       &kp BSPC

                &kp ES_PIP  &kp ES_LBR  &kp ES_RBR  &kp ES_LPR  &kp ES_RPR  &kp ES_EQL
                &kp C_PP    &kp ES_QOT  &kp C_VOL_DN   &kp C_VOL_UP   &none  &none

                &kp ES_BSL  &kp ES_LBK  &kp ES_RBK  &kp ES_LT   &kp ES_GT   &kp ES_QMK
                &none       &kp ES_IQU  &none       &none       &none       &none

                &trans      &trans      &trans
                &kp SPC     &trans      &trans
            >;
        };

        /* ── 4: BT ─────────────────────────────────────────────────────── */
        bt_layer {
            display-name = "BT";
            bindings = <
                &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none

                &none          &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
                &none          &none          &none          &none          &none          &none

                &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &bt BT_CLR  &none

                &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };
    };
};
